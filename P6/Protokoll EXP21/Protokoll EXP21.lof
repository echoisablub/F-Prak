\contentsline {figure}{\numberline {1}{\ignorespaces A schematic of a pump-probe-experiment \cite {0}.}}{2}{figure.caption.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Schematic view of $[\text {Fe}(\text {bipy})_3]^{2+}$}}{3}{figure.caption.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces Optical layout of a four-crystal monochromator \cite {4}.}}{4}{figure.caption.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces The optical bench in the FXE hut with the following components implemented: BIU 1,2,3 (beam imaging units), SpA (spectrum analyser), TAD (time arrival detector), PS 1,2 (power slits), SAA (solid attenuator assembly), IPM1 (intensity position monitor), CRLs (compound refractive lenses) \cite {0}.}}{4}{figure.caption.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces X-Ray absorption spectrum of $[\text {Fe}(\text {terpy})_2]^{2+}$ (terpy: terpyridin) at the Fe K edge displaying the XANES and EXAFS regions including the background absorption contributions $\mu _0$. The inset zooms into the weak pre edge features \cite {0}.}}{6}{figure.caption.5}%
\contentsline {figure}{\numberline {6}{\ignorespaces The horizontal and vertical profile of the focussed X-ray beam plotted together with a gaussian fit and the corresponding FWHM of \qty {13.5}{\mu \m }.}}{7}{figure.caption.8}%
\contentsline {figure}{\numberline {7}{\ignorespaces UV/VIS absorption spectrum of an aqueous $[\text {Fe}(\text {bipy})_3]\text {Cl}_2$ solution. The different CT transitions are indicated. The measured molar absorptivity $\epsilon $ values lie in the expected range of $10^{-4}\text {\, l}\text {\,mol}^{-1}\text {\,cm}^{-1}$ to $10^{-5}\text {\, l}\text {\,mol}^{-1}\text {\,cm}^{-1}$ for dipole-allowed transitions\cite {0}}}{8}{figure.caption.9}%
\contentsline {figure}{\numberline {8}{\ignorespaces The Von Hamos spectrometer in operating position. with the read-out of the Jungfrau detector as well as the settings for the position to the left.}}{9}{figure.caption.10}%
\contentsline {figure}{\numberline {9}{\ignorespaces The reference spectra plotted with provided data for different spin states. The reference difference spectra with transient signals plotted with provided data for different transitions.}}{9}{figure.caption.11}%
\contentsline {figure}{\numberline {10}{\ignorespaces On the left the XES spectrum with the excitation laser on at a delay of \qty {100}{ps} is plotted. On the right there's the difference spectrum at the same time delay.}}{10}{figure.caption.12}%
\contentsline {figure}{\numberline {11}{\ignorespaces Transient spectra of the X-ray emission at different pump-probe time delays.}}{10}{figure.caption.13}%
\contentsline {figure}{\numberline {12}{\ignorespaces Kinetic traces at selected emission energies.}}{11}{figure.caption.14}%
\contentsline {figure}{\numberline {13}{\ignorespaces The population curves of the different spin states plotted against the time delay of the optical laser in femtoseconds.}}{11}{figure.caption.15}%
\contentsline {figure}{\numberline {14}{\ignorespaces The normalised residuals together with the actual measurements and a fit over ... for time delays of $\Delta t=\{\qty {-150}{fs},\qty {-100}{fs},\qty {-50}{fs},\qty {0}{fs},\qty {50}{fs}\}$}}{12}{figure.caption.16}%
\contentsline {figure}{\numberline {15}{\ignorespaces The photon counts of the different excited states for negative time delays.}}{13}{figure.caption.17}%
\contentsline {figure}{\numberline {16}{\ignorespaces The adjusted population curves of the different spin states plotted against the time delay of the optical laser in femtoseconds.}}{13}{figure.caption.18}%
