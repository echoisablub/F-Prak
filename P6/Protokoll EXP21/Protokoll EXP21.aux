\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces X-ray emission spectrum measured with the excitation laser on at a delay of \qty {100}{ps} (left) and the corresponding laser-on minus laser-off difference spectrum (right). The comparison separates the dominant emission features from the transient changes caused by the optical excitation.}}{14}{figure.caption.18}\protected@file@percent }
\newlabel{fig:100ps all spec}{{16}{14}{X-ray emission spectrum measured with the excitation laser on at a delay of \qty {100}{ps} (left) and the corresponding laser-on minus laser-off difference spectrum (right). The comparison separates the dominant emission features from the transient changes caused by the optical excitation}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Difference spectra for different pump-probe delays}{15}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Transient X-ray emission difference spectra recorded at different pump-probe delays. The positive feature near \qty {7045}{eV}, the negative minimum near \qty {7058}{eV} and the evolving shoulder around \qty {7054}{eV} change with delay, showing that the emission spectrum responds to the laser excitation and evolves as the spin-state populations change. The relatively small differences between the spectra at \qty {600}{fs} and \qty {800}{fs} suggest that the system is approaching a more stable excited-state distribution.}}{15}{figure.caption.19}\protected@file@percent }
\newlabel{fig:time res spec}{{17}{15}{Transient X-ray emission difference spectra recorded at different pump-probe delays. The positive feature near \qty {7045}{eV}, the negative minimum near \qty {7058}{eV} and the evolving shoulder around \qty {7054}{eV} change with delay, showing that the emission spectrum responds to the laser excitation and evolves as the spin-state populations change. The relatively small differences between the spectra at \qty {600}{fs} and \qty {800}{fs} suggest that the system is approaching a more stable excited-state distribution}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Kinetic traces of the transient signal at four selected emission energies as a function of pump-probe delay. Comparing these energies shows that the spectral features change systematically in time, confirming that the signal contains measurable dynamics rather than isolated statistical fluctuations and providing suitable traces for the subsequent analysis.}}{16}{figure.caption.20}\protected@file@percent }
\newlabel{fig:kin traces}{{18}{16}{Kinetic traces of the transient signal at four selected emission energies as a function of pump-probe delay. Comparing these energies shows that the spectral features change systematically in time, confirming that the signal contains measurable dynamics rather than isolated statistical fluctuations and providing suitable traces for the subsequent analysis}{figure.caption.20}{}}
\BKM@entry{id=25,dest={73656374696F6E2E36},srcline={507}}{}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Spin-state populations obtained by fitting the measured difference spectrum at each pump-probe delay. The singlet dominates before excitation and then decreases, while the triplet population appears transiently before the quintet grows to dominate, consistent with relaxation through a short-lived intermediate towards the high-spin state. The small doublet and quartet contributions are less conclusive and may reflect correlations between reference spectra.}}{17}{figure.caption.21}\protected@file@percent }
\newlabel{fig:pop fit}{{19}{17}{Spin-state populations obtained by fitting the measured difference spectrum at each pump-probe delay. The singlet dominates before excitation and then decreases, while the triplet population appears transiently before the quintet grows to dominate, consistent with relaxation through a short-lived intermediate towards the high-spin state. The small doublet and quartet contributions are less conclusive and may reflect correlations between reference spectra}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Singlet population extracted from the spectral decomposition together with the Gaussian temporal-transition fit. The fitted midpoint $t_0$ marks the effective temporal position of the excitation, while the fit width describes the finite temporal spread of the pump-probe response.}}{17}{figure.caption.22}\protected@file@percent }
\newlabel{fig:singlet transition fit}{{20}{17}{Singlet population extracted from the spectral decomposition together with the Gaussian temporal-transition fit. The fitted midpoint $t_0$ marks the effective temporal position of the excitation, while the fit width describes the finite temporal spread of the pump-probe response}{figure.caption.22}{}}
