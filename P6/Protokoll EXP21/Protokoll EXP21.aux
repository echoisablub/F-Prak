\newlabel{fig:ref spectra}{{15}{14}{Reference X-ray emission spectra for the different spin states together with the corresponding reference difference spectra. These spectra provide the basis for identifying the spin-state contributions in the measured transient signal}{figure.caption.17}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}XES spectra at 100ps}{14}{subsection.5.1}\protected@file@percent }
