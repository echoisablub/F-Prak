\newlabel{fig:xray}{{12}{12}{Spatial intensity profile of the focused X-ray beam at the sample position. Its compact spot defines the region of the liquid jet probed by the X-rays and serves as the reference for checking pump-probe overlap}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Spatial intensity profile of the optical excitation laser at the sample position, showing the region excited by the pump pulse. Its size is compared with the X-ray spot to ensure that the probe interrogates laser-excited molecules.}}{13}{figure.caption.15}\protected@file@percent }
