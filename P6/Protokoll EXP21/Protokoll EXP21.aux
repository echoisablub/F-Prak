\newlabel{sub@fig:100ps spec}{{}{14}{XES spectra at 100ps}{figure.caption.18}{}}
\newlabel{fig:100ps diff spec}{{\caption@xref {??}{ on input line 430}}{14}{XES spectra at 100ps}{figure.caption.18}{}}
