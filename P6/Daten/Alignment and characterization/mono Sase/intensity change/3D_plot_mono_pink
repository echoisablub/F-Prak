import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import interp1d

# Load data
filename_mono = "Daten/Alignment and characterization/mono Sase/intensity change/mono_BIU_2.txt"
filename_pink = "Daten/Alignment and characterization/mono Sase/intensity change/pink_BIU_2.txt"

data_mono = np.loadtxt(filename_mono, delimiter=",", comments="#")
data_pink = np.loadtxt(filename_pink, delimiter=",", comments="#")

# BIU2 image is 420 x 420 pixels
image_mono = data_mono.reshape(420, 420)
image_pink = data_pink.reshape(420, 420)

# Pixel coordinates
x_mono = np.arange(image_mono.shape[1])
y_mono = np.arange(image_mono.shape[0])

# Pixel coordinates
x_pink = np.arange(image_pink.shape[1])
y_pink = np.arange(image_pink.shape[0])


plt.figure(figsize=(8, 6))
im = plt.imshow(data_mono, cmap='viridis', origin='lower')
plt.colorbar(im, label='Intensity (arb. u.)')
plt.title('2D Monochromatic Beam Intensity Profile on Detector', fontsize=12, fontweight='bold')
plt.xlabel('X-Pixel Position')
plt.ylabel('Y-Pixel Position')
plt.tight_layout()
plt.savefig('Daten/Alignment and characterization/mono Sase/intensity change/beam_profile_2d_mono.png', dpi=150)
plt.show()

plt.figure(figsize=(8, 6))
im = plt.imshow(data_pink, cmap='viridis', origin='lower')
plt.colorbar(im, label='Intensity (arb. u.)')
plt.title('2D Pink Beam Intensity Profile on Detector', fontsize=12, fontweight='bold')
plt.xlabel('X-Pixel Position')
plt.ylabel('Y-Pixel Position')
plt.tight_layout()
plt.savefig('Daten/Alignment and characterization/mono Sase/intensity change/beam_profile_2d_pink.png', dpi=150)
plt.show()

from mpl_toolkits.mplot3d import Axes3D

X, Y = np.meshgrid(x_mono, y_mono)

fig = plt.figure(figsize=(10, 8))
ax = fig.add_subplot(111, projection='3d')

# Plot the surface (using 'stride' downsamples the grid slightly to render faster)
surf = ax.plot_surface(X, Y, data_mono, cmap='viridis', rstride=4, cstride=4, 
                       edgecolor='none', alpha=0.9)

fig.colorbar(surf, ax=ax, shrink=0.5, aspect=10, label='Intensity (arb. u.)')
ax.set_title('3D Reconstructed Monochromatic Beam Intensity Profile', fontsize=12, fontweight='bold')
ax.set_xlabel('X-Pixel')
ax.set_ylabel('Y-Pixel')
ax.set_zlabel('Intensity')

# Adjust the viewing angle for the best perspective
ax.view_init(elev=30, azim=45)
plt.tight_layout()
plt.savefig('Daten/Alignment and characterization/mono Sase/intensity change/beam_profile_3d_mono.png', dpi=150)
plt.show()

