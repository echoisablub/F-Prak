\contentsline {figure}{\numberline {1}{\ignorespaces A schematic representation of the rotation of H1 clouds around the galactic centre together with the resulting line profile to the right \cite {0}.}}{5}{figure.caption.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Effective background temperature as a function elevation (left figure) or azimuth (right figure).}}{7}{figure.caption.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces The extrapolated course of $T'_{h}$ up to an elevation of \qty {0}{\degree } (for left and right hand polarisation)}}{7}{figure.caption.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Gaussian fit of the left polarised scan of the longitude (left figure) and latitude (right figure). The FWHM of the fit is marked at \qty {4.6}{\degree } for the longitude scan and at \qty {4.39}{\degree } for the latitude scan. The errorbars in both figures are to small to be seen at the scale of the antenna temperature.}}{8}{figure.caption.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Gaussian fit of the right polarised scan of the longitude (left figure) and latitude (right figure). The FWHM of the fit is marked at \qty {4.78}{\degree } for the longitude scan and at \qty {4.63}{\degree } for the latitude scan. The errorbars in the right figure are remarkably high when contrasted with both the left figure as well as \autoref {fig:gaus_fit_left}.}}{8}{figure.caption.5}%
